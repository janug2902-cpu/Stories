# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public project URL from your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe to expose to browser for RLS protected queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret service role key (NEVER expose to client; used for admin-level operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ==============================================================================
# OpenRouter AI Configuration (Multi-Key Failover / Load Balancing)
# ==============================================================================
# Primary API key for OpenRouter AI story generation and completion
OPENROUTER_KEY_PRIMARY=sk-or-v1-primary-key-here

# Backup API key 1 for failover when quota is exhausted or rate limit hit
OPENROUTER_KEY_BACKUP_1=sk-or-v1-backup-key-1-here

# Backup API key 2 for secondary failover
OPENROUTER_KEY_BACKUP_2=sk-or-v1-backup-key-2-here
